---
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import '@/styles/global.css' 
// add prop locals astro add it in middleware.ts and type in env.d.ts
//const { title_md } = Astro.locals;
const title = Astro.props.title;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
	</head>
	<body>
		<Header/>
		<main>
			<slot />
		</main>		
		<Footer/>
	</body>
</html>
<style is:global>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		display: grid;
		min-height: 100dvh;
		grid-template-rows: auto 1fr auto;
	}
</style>



