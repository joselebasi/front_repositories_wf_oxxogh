---
import { SignedIn, SignedOut, UserButton, SignInButton} from "@clerk/astro/components";
---
<header class="bg-blue-500 text-white flex items-center justify-center">
  <div>
    <img src="/favicon.svg" alt="Astro Logo" width="100" height="100" />
  </div>
  <h1>HEADER</h1>
  <nav>
        <SignedOut>
          <SignInButton mode="modal" class="text-white font-semibold rounded-full px-4 py-2">Sign In</SignInButton>
        </SignedOut>
        <SignedIn>
          <UserButton showName/>
        </SignedIn>
      </nav>
</header>