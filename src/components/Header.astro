---
import { SignedIn, SignedOut, UserButton, SignInButton} from "@clerk/astro/components";
---
<header class="flex justify-between items-center p-8 bg-[#B91C1C]">
  <div>
    <img src="/logo1.png" alt="Ingenieria logo" width="90" height="90" />  
    <h1>INGENIERIA</h1>
    <h2>SOLUCIONES RH, FINANZAS Y CADENA DE SUMINISTRO</h2>
  </div>
  <nav>
        <SignedOut>
          <SignInButton mode="modal" class="text-white font-semibold rounded-full px-4 py-2">Sign In</SignInButton>
        </SignedOut>
        <SignedIn>
          <UserButton showName/>
        </SignedIn>
      </nav>
</header>