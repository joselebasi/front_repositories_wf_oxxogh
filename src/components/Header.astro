---
import {
  SignedIn,
  SignedOut,
  UserButton,
  SignInButton,
  OrganizationSwitcher,
} from "@clerk/astro/components";
import OxxoLogo from "./OxxoLogo.astro";
---

<header class="flex justify-between items-center px-12 py-4 bg-[#B91C1C]">
  <div class="flex items-center gap-6">
    <a href="/" class="flex-shrink-0 cursor-pointer">
      <OxxoLogo width="90" height="60" class="flex-shrink-0" />
    </a>
    <div class="border-l-2 border-white/30 h-20"></div>
    <div
      class="flex flex-col items-center justify-center leading-tight text-center"
    >
      <a href="/" class="cursor-pointer">
        <img src="/logo1.png" alt="Ingeniería" width="60" />
      </a>

      <span class="text-black font-extrabold text-xs tracking-wide">
        INGENIERÍA
      </span>

      <span class="text-black text-xs tracking-wide">
        SOLUCIONES RH, FINANZAS
      </span>

      <span class="text-black text-xs tracking-wide">
        Y CADENA DE SUMINISTRO
      </span>
    </div>
  </div>
  <nav class="flex flex-col space-y-4">
    <SignedOut>
      <SignInButton
        mode="modal"
        class="text-black bg-[#ffc627] font-semibold hover:shadow-xl hover:scale-105 rounded-full px-4 py-2"
        >Iniciar sesión</SignInButton
      >
    </SignedOut>
    <SignedIn>
      <UserButton showName />
      <OrganizationSwitcher />
    </SignedIn>
  </nav>
</header>
