
<div class="container mx-auto p-4">
  <form class="max-w-md mx-auto mb-8" id="technicalLeaderForm">
      <div class="relative z-0 w-full mb-5 group">
          <input type="text" name="floating_name" id="floating_name" class="block py-2.5 px-0 w-full text-sm text-gray-900 bg-transparent border-0 border-b-2 border-gray-300 appearance-none dark:text-white dark:border-gray-600 dark:focus:border-blue-500 focus:outline-none focus:ring-0 focus:border-blue-600 peer" placeholder=" " required />
          <label for="floating_name" class="peer-focus:font-medium absolute text-sm text-gray-500 dark:text-gray-400 duration-300 transform -translate-y-6 scale-75 top-3 -z-10 origin-[0] peer-focus:start-0 rtl:peer-focus:translate-x-1/4 peer-focus:text-blue-600 peer-focus:dark:text-blue-500 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-6">First name</label>
      </div>
      <div class="relative z-0 w-full mb-5 group">
          <input type="text" name="floating_middle_name" id="floating_middle_name" class="block py-2.5 px-0 w-full text-sm text-gray-900 bg-transparent border-0 border-b-2 border-gray-300 appearance-none dark:text-white dark:border-gray-600 dark:focus:border-blue-500 focus:outline-none focus:ring-0 focus:border-blue-600 peer" placeholder=" " required />
          <label for="floating_middle_name" class="peer-focus:font-medium absolute text-sm text-gray-500 dark:text-gray-400 duration-300 transform -translate-y-6 scale-75 top-3 -z-10 origin-[0] peer-focus:start-0 rtl:peer-focus:translate-x-1/4 peer-focus:text-blue-600 peer-focus:dark:text-blue-500 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-6">Middle name</label>
      </div>
      <div class="relative z-0 w-full mb-5 group">
          <input type="text" name="floating_last_name" id="floating_last_name" class="block py-2.5 px-0 w-full text-sm text-gray-900 bg-transparent border-0 border-b-2 border-gray-300 appearance-none dark:text-white dark:border-gray-600 dark:focus:border-blue-500 focus:outline-none focus:ring-0 focus:border-blue-600 peer" placeholder=" " required />
          <label for="floating_last_name" class="peer-focus:font-medium absolute text-sm text-gray-500 dark:text-gray-400 duration-300 transform -translate-y-6 scale-75 top-3 -z-10 origin-[0] peer-focus:start-0 rtl:peer-focus:translate-x-1/4 peer-focus:text-blue-600 peer-focus:dark:text-blue-500 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-6">Last name</label>
      </div>
    <div class="relative z-0 w-full mb-5 group">
        <input type="email" name="floating_email" id="floating_email" class="block py-2.5 px-0 w-full text-sm text-gray-900 bg-transparent border-0 border-b-2 border-gray-300 appearance-none dark:text-white dark:border-gray-600 dark:focus:border-blue-500 focus:outline-none focus:ring-0 focus:border-blue-600 peer" placeholder=" " required />
        <label for="floating_email" class="peer-focus:font-medium absolute text-sm text-gray-500 dark:text-gray-400 duration-300 transform -translate-y-6 scale-75 top-3 -z-10 origin-[0] peer-focus:start-0 rtl:peer-focus:translate-x-1/4 rtl:peer-focus:left-auto peer-focus:text-blue-600 peer-focus:dark:text-blue-500 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-6">Email address</label>
    </div>
    
    <button type="submit" class="text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm w-full sm:w-auto px-5 py-2.5 text-center dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800">Submit</button>
  </form>

  <div class="relative overflow-x-auto shadow-md sm:rounded-lg">
    <table class="w-full text-sm text-left rtl:text-right text-gray-500 dark:text-gray-400">
      <thead class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400">
        <tr>
          <th scope="col" class="px-6 py-3">ID</th>
          <th scope="col" class="px-6 py-3">Name</th>
          <th scope="col" class="px-6 py-3">Middle Name</th>
          <th scope="col" class="px-6 py-3">Last Name</th>
          <th scope="col" class="px-6 py-3">Email</th>
          <th scope="col" class="px-6 py-3">Created At</th>
        </tr>
      </thead>
      <tbody id="technicalLeadersTable">
      </tbody>
    </table>
  </div>
</div>
<script>
import { actions } from 'astro:actions';

const button = document.querySelector('button');
const table = document.querySelector('#technicalLeadersTable');

async function loadTechnicalLeaders() {
  const { data: technicalLeadersData, error: technicalLeadersError } = await actions.wf_technical_leader.getAllWfTechnicalLeaders();
  
  if (technicalLeadersError) {
    console.error('Error loading technical leaders:', technicalLeadersError);
    return;
  }

  if (table && technicalLeadersData) {
    table.innerHTML = technicalLeadersData.map(leader => `
      <tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-600">
        <td class="px-6 py-4">${leader.id}</td>
        <td class="px-6 py-4">${leader.name}</td>
        <td class="px-6 py-4">${leader.middle_name}</td>
        <td class="px-6 py-4">${leader.last_name}</td>
        <td class="px-6 py-4">${leader.email}</td>
        <td class="px-6 py-4">${new Date(leader.created_at).toLocaleString()}</td>
      </tr>
    `).join('');
  }
}

loadTechnicalLeaders();

button?.addEventListener('click', async (e) => {
  e.preventDefault();
  
  const formFields = {
    name: 'floating_name',
    middle_name: 'floating_middle_name',
    last_name: 'floating_last_name',
    email: 'floating_email'
  };

  const formData = Object.entries(formFields).reduce((acc, [key, id]) => {
    const input = document.querySelector(`#${id}`) as HTMLInputElement;
    acc[key] = input?.value || `no ${key}`;
    return acc;
  }, {} as Record<string, string>);

  const { data, error } = await actions.wf_technical_leader.saveWfTechnicalLeader({
    name: formData.name,
    middle_name: formData.middle_name,
    last_name: formData.last_name,
    email: formData.email
  });

  if (error) {
    alert('Error saving technical leader: ' + error);
  } else {
    alert('Technical leader saved successfully!');
    // Clear form
    Object.values(formFields).forEach(id => {
      const input = document.querySelector(`#${id}`) as HTMLInputElement;
      if (input) input.value = '';
    });
    // Reload table data
    await loadTechnicalLeaders();
  }
});
</script>