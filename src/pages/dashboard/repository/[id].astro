---
import { actions } from 'astro:actions';
import Layout from '@/layouts/Layout.astro';

const { id } = Astro.params;
console.log('Repository ID:', id);
const { data } = await Astro.callAction(actions.wf_repositories_data.getWfRepositoriesDataById, { id: Number(id) });
console.log(data);
---
<Layout title={`Repository ${id} Details`}>
  <div>
    <h1>Repository Details</h1>
    {data ? (
      <pre>{JSON.stringify(data, null, 2)}</pre>
    ) : (
      <p>No data found.</p>
    )}
  </div>
</Layout>