---
import { actions } from 'astro:actions';
import Layout from '@/layouts/Layout.astro';
import RepositoryInfo from '@/components/RepositoryInfo.astro';
import RepositoryLog from '@/components/RepositoryLog.jsx';

const user = await Astro.locals.currentUser();
console.log('Current User:', user?.username);
const userName = user?.username;
const { id } = Astro.params;
console.log('Repository ID:', id);
import type { WfRepositoryData } from '@/actions/wf_repositories_data';
const result = await Astro.callAction(actions.wf_repositories_data.getWfRepositoriesDataById, { id: Number(id) });
const data: WfRepositoryData | null = result.error ? null : result.data;

---
<Layout title={`Repository ${id} Details`}>
  <RepositoryInfo name={data?.name} tipo={data?.wf_repositories_data_id_type_repository_fkey.name} />
  <RepositoryLog id_repository={id} userName={userName} />
</Layout>