---
import RepositoryTable from "@/components/RepositoryTable.jsx";
import Layout from "@/layouts/Layout.astro";
import { SignedIn, SignedOut, Protect } from "@clerk/astro/components";

const { orgRole } = Astro.locals.auth();
---

<Layout title="Ing Backoffice">
	<section
		class="min-h-[calc(100vh-200px)] bg-gradient-to-br from-slate-50 via-blue-50 to-indigo-50 py-12 px-4 sm:px-6 lg:px-8"
	>
		<div class="max-w-7xl mx-auto">
			<!-- Hero Section -->
			<div class="text-center mb-12 animate-fade-in">
				<h1
					class="text-4xl sm:text-5xl lg:text-6xl font-bold text-gray-900 mb-4 tracking-tight"
				>
					Ingeniería Backoffice
				</h1>
			</div>

			<!-- Signed Out State -->
			<SignedOut>
				<div class="max-w-md mx-auto mt-12">
					<div
						class="bg-white rounded-2xl shadow-xl p-8 border border-gray-100"
					>
						<div
							class="flex items-center justify-center w-16 h-16 bg-[#fec630]/20 rounded-full mx-auto mb-6"
						>
							<svg
								class="w-8 h-8 text-[#fec630]"
								fill="none"
								stroke="currentColor"
								viewBox="0 0 24 24"
								aria-hidden="true"
							>
								<path
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="2"
									d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
								></path>
							</svg>
						</div>
						<h2
							class="text-2xl font-bold text-gray-900 text-center mb-4"
						>
							Acceso Requerido
						</h2>
						<p class="text-gray-600 text-center text-lg">
							Por favor inicia sesión para acceder al sitio.
						</p>
					</div>
				</div>
			</SignedOut>

			<!-- Signed In State -->
			<SignedIn>
				{
					!orgRole && (
						<div class="max-w-2xl mx-auto mt-8 animate-fade-in">
							<div class="bg-white rounded-2xl shadow-xl overflow-hidden border border-gray-100">
								<div class="bg-gradient-to-r from-[#fec630] to-[#f5a623] h-2" />
								<div class="p-8">
									<div class="flex items-center justify-center w-16 h-16 bg-[#fec630]/10 rounded-full mx-auto mb-6">
										<svg
											class="w-8 h-8 text-[#fec630]"
											fill="none"
											stroke="currentColor"
											viewBox="0 0 24 24"
											aria-hidden="true"
										>
											<path
												stroke-linecap="round"
												stroke-linejoin="round"
												stroke-width="2"
												d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
											/>
										</svg>
									</div>
									<h2 class="text-2xl font-bold text-gray-900 text-center mb-4">
										Acceso Restringido
									</h2>
									<p class="text-gray-600 text-center text-lg mb-8">
										Lo sentimos, actualmente no cuentas con
										roles asignados para acceder a las
										herramientas de la plataforma.
									</p>
									<div class="bg-slate-50 border-l-4 border-[#fec630] p-6 rounded-r-xl">
										<p class="text-sm text-gray-600 font-medium mb-3 uppercase tracking-wider">
											Cómo obtener acceso
										</p>
										<p class="text-gray-700 mb-4">
											Por favor, ponte en contacto con el
											administrador del sistema para
											solicitar los permisos necesarios:
										</p>
										<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 p-4 bg-white rounded-lg border border-gray-100 shadow-sm">
											<div class="flex items-center space-x-3">
												<div class="w-10 h-10 bg-gray-100 rounded-full flex items-center justify-center text-gray-500">
													JT
												</div>
												<div>
													<p class="font-bold text-gray-900">
														Jose Toledano
													</p>
													<p class="text-sm text-gray-500">
														Administrador del
														Sistema
													</p>
												</div>
											</div>
											<a
												href="mailto:jose.toledano@axity.com"
												class="inline-flex items-center justify-center px-4 py-2 bg-[#fec630] hover:bg-[#f5a623] text-white font-semibold rounded-lg transition-colors duration-200 group"
											>
												<svg
													class="w-4 h-4 mr-2"
													fill="none"
													stroke="currentColor"
													viewBox="0 0 24 24"
												>
													<path
														stroke-linecap="round"
														stroke-linejoin="round"
														stroke-width="2"
														d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
													/>
												</svg>
												jose.toledano@axity.com
											</a>
										</div>
									</div>
								</div>
							</div>
						</div>
					)
				}
				<!-- Member Navigation -->
				<Protect role="org:member">
					<div class="max-w-4xl mx-auto">
						<h2
							class="text-2xl font-bold text-gray-900 mb-6 text-center"
						>
							Herramientas Disponibles
						</h2>
						<nav
							aria-label="Navegación de miembro"
							class="grid gap-6"
						>
							<a
								href="/dashboard/members-activity-backoffice"
								class="group relative bg-white rounded-xl shadow-lg hover:shadow-2xl transition-all duration-300 p-8 border border-gray-200 hover:border-[#fec630] focus:outline-none focus:ring-4 focus:ring-[#fec630] focus:ring-opacity-50 transform hover:-translate-y-1"
								aria-label="Ir a Members Activity"
							>
								<div class="flex items-center justify-between">
									<div class="flex items-center space-x-4">
										<div
											class="flex-shrink-0 w-14 h-14 bg-gradient-to-br from-[#fec630] to-[#f5a623] rounded-lg flex items-center justify-center group-hover:scale-110 transition-transform duration-300"
										>
											<svg
												class="w-7 h-7 text-white"
												fill="none"
												stroke="currentColor"
												viewBox="0 0 24 24"
												aria-hidden="true"
											>
												<path
													stroke-linecap="round"
													stroke-linejoin="round"
													stroke-width="2"
													d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
												></path>
											</svg>
										</div>
										<div>
											<h3
												class="text-xl font-semibold text-gray-900 group-hover:text-[#fec630] transition-colors"
											>
												Members Activity
											</h3>
											<p class="text-gray-600 mt-1">
												Ver actividad de los miembros
												del equipo
											</p>
										</div>
									</div>
									<svg
										class="w-6 h-6 text-gray-400 group-hover:text-[#fec630] group-hover:translate-x-1 transition-all"
										fill="none"
										stroke="currentColor"
										viewBox="0 0 24 24"
										aria-hidden="true"
									>
										<path
