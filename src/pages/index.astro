												></path>
											</svg>
										</div>
										<div>
											<h3
												class="text-xl font-semibold text-gray-900 group-hover:text-[#fec630] transition-colors"
											>
												Actividad en repositorios
											</h3>
											<p class="text-gray-600 mt-1">
												Mostrar ramas, ultimo commit y
												pr's abiertos por repositorio
											</p>
										</div>
									</div>
									<svg
										class="w-6 h-6 text-gray-400 group-hover:text-[#fec630] group-hover:translate-x-1 transition-all"
										fill="none"
										stroke="currentColor"
										viewBox="0 0 24 24"
										aria-hidden="true"
									>
										<path
											stroke-linecap="round"
											stroke-linejoin="round"
											stroke-width="2"
											d="M9 5l7 7-7 7"></path>
									</svg>
								</div>
							</a>
							<!-- Menu Card -->
						</nav>
					</div>
				</Protect>

				<!-- Admin Navigation -->
				<Protect role="org:admin">
					<div class="max-w-4xl mx-auto">
						<h2
							class="text-2xl font-bold text-gray-900 mb-6 text-center"
						>
							Panel de Administración
						</h2>
						<nav
							aria-label="Navegación de administrador"
							class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3"
						>
							<!-- Menu Card -->
							<a
								href="/dashboard/bo-repository-branches-activity"
								class="group relative bg-white rounded-xl shadow-lg hover:shadow-2xl transition-all duration-300 p-6 border border-gray-200 hover:border-[#fec630] focus:outline-none focus:ring-4 focus:ring-[#fec630] focus:ring-opacity-50 transform hover:-translate-y-1"
								aria-label="Ir al menú principal"
							>
								<div class="flex flex-col h-full">
									<div
										class="flex-shrink-0 w-12 h-12 bg-gradient-to-br from-[#fec630] to-[#f5a623] rounded-lg flex items-center justify-center mb-4 group-hover:scale-110 transition-transform duration-300"
									>
										<svg
											class="w-6 h-6 text-white"
											fill="none"
											stroke="currentColor"
											viewBox="0 0 24 24"
											aria-hidden="true"
										>
											<path
												stroke-linecap="round"
												stroke-linejoin="round"
												stroke-width="2"
												d="M4 6h16M4 12h16M4 18h16"
											></path>
										</svg>
									</div>
									<h3
										class="text-lg font-semibold text-gray-900 group-hover:text-[#fec630] transition-colors mb-2"
									>
										Menú
									</h3>
									<p class="text-gray-600 text-sm flex-grow">
										Acceso al menú principal de
										administración
									</p>
									<div
										class="mt-4 flex items-center text-[#fec630] font-medium text-sm"
									>
										<span>Acceder</span>
										<svg
											class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform"
											fill="none"
											stroke="currentColor"
											viewBox="0 0 24 24"
											aria-hidden="true"
										>
											<path
